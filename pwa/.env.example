# Copy to pwa/.env.local (gitignored) to override. All values below are the defaults (src/server/env.ts).

# Deployment environment: dev | staging | prod (prod requires https origins and the redis session store)
CARPAL_ENV=dev

# Public origin of the PWA (canonical URLs, the BFF's Origin check and its OAuth redirect URI <origin>/bff/oauth/callback)
CARPAL_PWA_ORIGIN=http://localhost:3000

# Backend hosts (backend `pnpm dev`, lite mode)
CARPAL_API_URL=http://127.0.0.1:8080
CARPAL_AUTH_URL=http://127.0.0.1:8082
CARPAL_STORAGE_URL=http://127.0.0.1:8083

# Backend's API audience (DPoP htu) and strict mode switch; keep them equal to the backend's values
CARPAL_API_AUDIENCE=https://api.carpal.app
CARPAL_STRICT_AUTH=0

# Map style override (GD-12); empty = config.client region.map.style_url, then the built-in fallback style
CARPAL_PWA_MAP_STYLE_URL=

# BFF session store (GD-08): lite (in-memory, one process) | redis
CARPAL_PWA_SESSION_STORE=lite
CARPAL_PWA_REDIS_URL=

# Maintenance mode (W-SYS-01): empty/off = live, "on" = no estimate, an ISO time (2026-10-25T14:30:00Z) = until then.
# Every localized page answers the 503 maintenance page with Retry-After.
CARPAL_PWA_MAINTENANCE=

# Demo/test pages (/<locale>/dev-kit and its status rewrites): 1 for local development and E2E only; refused in prod
CARPAL_PWA_DEMO=0

# Time zone for dates until the visitor's browser reports its own (IANA name; OQ-13)
CARPAL_PWA_DEFAULT_TIME_ZONE=Asia/Tehran

# Versions of the Terms and the Privacy Policy accepted at sign-up and named in consent records (1-20 characters)
CARPAL_PWA_TERMS_VERSION=2026-10
CARPAL_PWA_PRIVACY_VERSION=2026-10

# Business portal sign-up, linked from onboarding step 1 (placeholder until the portal exists)
CARPAL_PWA_PORTAL_SIGNUP_URL=https://portal.carpal.app/signup

# Dev/E2E only: the registered https redirect URI when this PWA runs on http://localhost (the backend accepts https
# redirect URIs only, DI-24). Empty = <CARPAL_PWA_ORIGIN>/bff/oauth/callback. Refused in prod.
CARPAL_PWA_OAUTH_REDIRECT_URI=
