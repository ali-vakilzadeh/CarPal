# CarPal consumer PWA environment (/carpal/config/pwa.env, root:@PWA_SERVICE_GROUP@ 0640).
# Read by systemd (EnvironmentFile) and by pwa-update.sh for `next build`. KEY=value, no spaces around "=",
# no "export", JSON values in single quotes. pwa-setup.sh wrote it once; it is never overwritten. Every variable is validated at
# startup (pwa/src/server/env.ts): the service refuses to start and journald names the bad value.
# After a change: sudo bash pwa-update.sh (pages prerendered by `next build` read these values too).

# --- Environment -------------------------------------------------------------------
# prod enforces https origins, the Redis session store, no demo pages and no redirect shim.
CARPAL_ENV=prod
# Must equal the backend's CARPAL_STRICT_AUTH (backend.env): DPoP-bound tokens and private_key_jwt client authentication.
CARPAL_STRICT_AUTH=1
# Private keys for private_key_jwt (secret; the public halves are the backend's CARPAL_OAUTH_CLIENT_JWKS).
CARPAL_PWA_CLIENT_PRIVATE_JWKS='@CLIENT_PRIVATE_JWKS@'

# --- Public origin (canonical URLs, the BFF's Origin check, OAuth redirect <origin>/bff/oauth/callback) ----
# Must be listed in the backend's CARPAL_OAUTH_REDIRECT_URIS (cp-web-consumer), CARPAL_WEBAUTHN_ORIGINS and
# CARPAL_MEDIA_CORS_ORIGINS, and CARPAL_LINK_BASE_URL must be <origin>/l.
CARPAL_PWA_ORIGIN=https://@WEB_HOST@

# --- Backend (server side only; the browser never calls these addresses) -----------------
# The BFF runs on the backend's server and reaches it over 127.0.0.1; https://@API_HOST@ is the backend's public name
# (the audience below) for clients outside this server. See deploy.md "How it fits together" for a PWA on its own server.
CARPAL_API_URL=@BACKEND_API_URL@
CARPAL_AUTH_URL=@BACKEND_AUTH_URL@
# Browser-facing media host (signed upload/download URLs; the page CSP admits it). Must be https in prod.
CARPAL_STORAGE_URL=https://@MEDIA_HOST@
# Equal to the backend's CARPAL_API_AUDIENCE (the htu of the BFF's DPoP proofs).
CARPAL_API_AUDIENCE=https://@API_HOST@

# --- BFF session store (GD-08): Redis on this server (pwa-setup.sh configured it) --------------
CARPAL_PWA_SESSION_STORE=redis
CARPAL_PWA_REDIS_URL=redis://:@REDIS_PASSWORD@@127.0.0.1:@REDIS_PORT@/@REDIS_DB@

# --- Deployment settings -------------------------------------------------------------
CARPAL_PWA_DEFAULT_TIME_ZONE=Asia/Tehran
# "Contact support" and "Report a problem" (OQ-18): an address this domain can receive mail at.
CARPAL_PWA_SUPPORT_EMAIL=support@@DOMAIN@
CARPAL_PWA_PORTAL_URL=https://@PORTAL_HOST@
CARPAL_PWA_PORTAL_SIGNUP_URL=https://@PORTAL_HOST@/signup
# Map style (GD-12, OQ-02): empty = the region config's style, else the built-in style without a basemap.
CARPAL_PWA_MAP_STYLE_URL=
# Web push (OQ-26 open): the sender's public VAPID key. Empty = no push controls.
CARPAL_PWA_VAPID_PUBLIC_KEY=
# Maintenance mode: on, or an ISO time until which every page answers 503. Empty = live.
CARPAL_PWA_MAINTENANCE=
# Accepted policy versions: default = the "Version" lines of the published legal texts. Set only with a text change.
# CARPAL_PWA_TERMS_VERSION=1.0
# CARPAL_PWA_PRIVACY_VERSION=1.0

# --- Never in production ------------------------------------------------------------
CARPAL_PWA_DEMO=0
# CARPAL_PWA_OAUTH_REDIRECT_URI must stay unset (dev/E2E shim; refused in prod).
