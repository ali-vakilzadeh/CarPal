# CarPal backend service environment (/carpal/config/backend.env, root:carpal 0640).
# Read by systemd (EnvironmentFile) and by the deploy scripts (bash). Keep both readers happy:
# KEY=value, no spaces around "=", no "export", JSON values in single quotes.
# server-setup.sh generated the secrets below; back this file up with the databases —
# CARPAL_MASTER_SECRET derives the token signing keys and the storage encryption key:
# losing or changing it signs everybody out and makes encrypted uploads unreadable.

# --- Environment (see deploy.md "Environment choice") --------------------------------
# staging: real secrets, strict auth on (DPoP-bound tokens + private_key_jwt for the PWA), AI off by default.
# prod stays closed until the rest of NI-01 (deploy.md "Environment choice"). Must equal the PWA's CARPAL_STRICT_AUTH.
CARPAL_ENV=staging
CARPAL_INFRA=lite
CARPAL_STRICT_AUTH=1
CARPAL_LOG_LEVEL=info
CARPAL_REGION=ir-pilot

# --- Secrets -----------------------------------------------------------------------
CARPAL_MASTER_SECRET=@MASTER_SECRET@

# --- Database (external PostgreSQL on this server; data in /carpal/db) ----------------
CARPAL_DB_MODE=external
CARPAL_DB_HOST=127.0.0.1
CARPAL_DB_PORT=@PG_PORT@
CARPAL_DB_NAME=@DB_NAME@
CARPAL_ANALYTICS_DB_NAME=@ANALYTICS_DB_NAME@
CARPAL_DB_LOCALE=C
CARPAL_DB_POOL_MAX=10
CARPAL_ADMIN_EMAIL=admin@@DOMAIN@
CARPAL_DB_PASSWORD_MIGRATOR=@PW_MIGRATOR@
CARPAL_DB_PASSWORD_AUTH=@PW_AUTH@
CARPAL_DB_PASSWORD_API=@PW_API@
CARPAL_DB_PASSWORD_ADMIN_API=@PW_ADMIN_API@
CARPAL_DB_PASSWORD_WORKER=@PW_WORKER@
CARPAL_DB_PASSWORD_AI=@PW_AI@
CARPAL_DB_PASSWORD_READONLY=@PW_READONLY@
CARPAL_DB_PASSWORD_ANALYTICS_WRITER=@PW_ANALYTICS_WRITER@
CARPAL_DB_PASSWORD_ANALYTICS_READER=@PW_ANALYTICS_READER@

# --- HTTP: local listeners (nginx proxies them) and public names ----------------------
CARPAL_HTTP_BIND=127.0.0.1
CARPAL_API_PORT=8080
CARPAL_ADMIN_API_PORT=8081
CARPAL_AUTH_PORT=8082
CARPAL_STORAGE_PORT=8083
CARPAL_ISSUER=https://@AUTH_HOST@
CARPAL_API_AUDIENCE=https://@API_HOST@
CARPAL_ADMIN_API_AUDIENCE=https://@ADMIN_HOST@
CARPAL_MEDIA_BASE_URL=https://@MEDIA_HOST@
# Hosted sign-in UI (frontend; default <issuer>/signin):
# CARPAL_SIGNIN_URL=https://@AUTH_HOST@/signin
CARPAL_OAUTH_REDIRECT_URIS='{"cp-mobile":["https://@DOMAIN@/oauth/callback"],"cp-web-consumer":["https://@WEB_HOST@/bff/oauth/callback"],"cp-web-portal":["https://@PORTAL_HOST@/bff/oauth/callback"],"cp-web-admin":["https://@ADMIN_CONSOLE_HOST@/bff/oauth/callback"]}'
# Public keys of the confidential clients (private_key_jwt at /oauth/token). server-setup.sh made the pairs:
# oauth-client-keys.json (cp-web-consumer, cp-ssr; private halves in pwa.env) and oauth-admin-client-keys.json
# (cp-web-admin; private half for the admin console only). Strict mode refuses to start without cp-web-consumer and
# cp-ssr; without cp-web-admin it starts and every staff token request answers invalid_client.
CARPAL_OAUTH_CLIENT_JWKS='@CLIENT_PUBLIC_JWKS@'
CARPAL_WEBAUTHN_RP_ID=@DOMAIN@
CARPAL_WEBAUTHN_ORIGINS='["https://@WEB_HOST@","https://@PORTAL_HOST@","https://@ADMIN_CONSOLE_HOST@"]'
# The consumer PWA (https://@WEB_HOST@): emailed links open its /l pages, and its browsers PUT/GET signed media URLs.
CARPAL_LINK_BASE_URL=https://@WEB_HOST@/l
CARPAL_MEDIA_CORS_ORIGINS='["https://@WEB_HOST@"]'
CARPAL_I18N_BASE_URL=https://cdn.@DOMAIN@/i18n
CARPAL_CLIENT_LATEST_VERSION=1.0.0
CARPAL_CLIENT_MIN_VERSIONS='{}'

# --- AI (GD-35): unavailable = AI operations answer 503, everything else works; stub = deterministic demo results
CARPAL_MCP_MODE=unavailable

# --- Rate limits behind nginx (deploy.md "Known limitations": the backend sees 127.0.0.1 for every client,
# so the per-IP windows would be shared by all users). Until the backend trusts X-Forwarded-For, raise only the
# three IP windows here and let nginx enforce per-client limits (templates/nginx-carpal.conf).
CARPAL_RATE_LIMITS='{"public.read":[{"limit":120,"windowMs":60000,"scope":"anon"},{"limit":3000,"windowMs":86400000,"scope":"anon"},{"limit":60000,"windowMs":60000,"scope":"ip"}],"auth.signin":[{"limit":5,"windowMs":900000,"scope":"account"},{"limit":3000,"windowMs":900000,"scope":"ip"}],"auth.otp":[{"limit":3,"windowMs":3600000,"scope":"destination"},{"limit":5,"windowMs":86400000,"scope":"destination"},{"limit":2000,"windowMs":3600000,"scope":"ip"}]}'
CARPAL_MAX_INFLIGHT=512
