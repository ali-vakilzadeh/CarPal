# Copy to backend/.env (gitignored) to override defaults. All values below are the defaults.

# --- Environment ---------------------------------------------------------------
CARPAL_ENV=dev                     # dev | staging | prod (seeds flags per environment)

# --- Database (tools/db, tests) --------------------------------------------------
# embedded: local PostgreSQL 16 under backend/.data/pg (pnpm db:start / db:stop)
# external: an existing server, e.g. infrastructure/docker/docker-compose.yml
CARPAL_DB_MODE=embedded
CARPAL_DB_HOST=127.0.0.1
CARPAL_DB_PORT=54329
CARPAL_DB_SUPERUSER=postgres
CARPAL_DB_SUPERUSER_PASSWORD=postgres_dev
CARPAL_DB_NAME=carpal
CARPAL_ANALYTICS_DB_NAME=carpal_analytics
CARPAL_DB_LOCALE=C
CARPAL_ADMIN_EMAIL=admin@carpals.ir

# Login role passwords (default <role>_dev, e.g. carpal_api_dev). Development only:
# real environments get them from the secret manager (42 §10).
# CARPAL_DB_PASSWORD_MIGRATOR=
# CARPAL_DB_PASSWORD_AUTH=
# CARPAL_DB_PASSWORD_API=
# CARPAL_DB_PASSWORD_ADMIN_API=
# CARPAL_DB_PASSWORD_WORKER=
# CARPAL_DB_PASSWORD_AI=
# CARPAL_DB_PASSWORD_READONLY=
# CARPAL_DB_PASSWORD_ANALYTICS_WRITER=
# CARPAL_DB_PASSWORD_ANALYTICS_READER=
# CARPAL_DB_PASSWORD_AI=

# AI / MCP (S9, GD-35): stub = deterministic in-process tool results (dev default); unavailable = AI answers 503 (staging/prod default)
# CARPAL_MCP_MODE=stub
# CARPAL_MCP_TIMEOUT_MS=15000

# WebAuthn (S9, GD-31)
# CARPAL_WEBAUTHN_RP_ID=carpals.ir
# CARPAL_WEBAUTHN_ORIGINS=["https://pwa.carpals.ir","https://web.carpals.ir","https://admin.carpals.ir"]

# --- Runtime (S2: libs/config validates all of these at startup) --------------
CARPAL_INFRA=lite                   # lite = in-process adapters + embedded DB; full = docker compose services (GD-04)
CARPAL_STRICT_AUTH=0                # 1 enforces DPoP binding, private_key_jwt for the BFF clients, attestation/PoW (GD-06); required in prod
CARPAL_LOG_LEVEL=info               # fatal | error | warn | info | debug | trace | silent
CARPAL_REGION=ir-pilot              # shared/region-config/<region>.json

# HTTP listeners (pnpm dev runs all of them in one process) and public names used in tokens
CARPAL_HTTP_BIND=127.0.0.1
CARPAL_API_PORT=8080
CARPAL_ADMIN_API_PORT=8081
CARPAL_AUTH_PORT=8082
CARPAL_STORAGE_PORT=8083            # lite signed-URL storage (stands in for media.carpals.ir)
CARPAL_ISSUER=https://id.carpals.ir
CARPAL_API_AUDIENCE=https://api.carpals.ir
CARPAL_ADMIN_API_AUDIENCE=https://admin-api.carpals.ir
# CARPAL_MEDIA_BASE_URL=            # default http://127.0.0.1:<CARPAL_STORAGE_PORT>
CARPAL_LINK_BASE_URL=https://pwa.carpals.ir/l   # emailed links (verification, reset, invitations): <PWA origin>/l
CARPAL_I18N_BASE_URL=https://cdn.carpals.ir/i18n
CARPAL_I18N_VERSION=dev
CARPAL_CLIENT_MIN_VERSIONS={}       # e.g. {"cp-mobile":"1.2.0"} -> older apps get 400 CLIENT_UPGRADE_REQUIRED
CARPAL_CLIENT_LATEST_VERSION=1.0.0

# Auth server (S3, 40 §6.2)
# CARPAL_SIGNIN_URL=                # hosted sign-in UI; default <CARPAL_ISSUER>/signin
# CARPAL_OAUTH_CLIENT_JWKS=         # public keys for private_key_jwt, JSON {"cp-web-consumer":{"keys":[…]},"cp-ssr":{"keys":[…]},"cp-web-admin":{"keys":[…]}}; strict mode needs consumer and ssr, staff token requests need cp-web-admin (deploy/gen-client-keys.mjs, --admin)
# CARPAL_OAUTH_REDIRECT_URIS=       # exact redirect_uri allowlist per client (JSON); dev defaults in libs/config
# Consumer PWA in pwa/ (its dev plan GD-05, P2): the PWA proxies /id/* to this auth host and is its own BFF, so set
#   (leave CARPAL_SIGNIN_URL unset: the PWA rewrites the default <issuer>/signin to its own origin, which also works
#   on its Playwright port :3100 — P5)
#   CARPAL_OAUTH_REDIRECT_URIS={"cp-mobile":["https://carpals.ir/oauth/callback"],"cp-web-consumer":["https://localhost:3000/bff/oauth/callback","https://localhost:3100/bff/oauth/callback"],"cp-web-portal":["https://web.carpals.ir/bff/oauth/callback"],"cp-web-admin":["https://admin.carpals.ir/bff/oauth/callback"]}
#   CARPAL_WEBAUTHN_RP_ID=localhost  CARPAL_WEBAUTHN_ORIGINS=["https://localhost:3000"]
#   (P4: the :3100 redirect URI is for the PWA's Playwright runs; see pwa/README.md "Sign-in in development")
# (redirect URIs are Url = https only, Docs/40; the variable replaces the whole map, so keep the other clients).
# Admin console in frontend/admin-console/ (its dev-plan.json AC2, BR-06; backend S12): it is cp-web-admin, runs on
#   http://localhost:3200 (pnpm dev) and :3300 (pnpm e2e), proxies /id/* like the PWA, and brings the code back from the
#   registered https URI the same way (its OQ-11). To run the PWA and the console together, set the cp-web-admin
#   entry of the map above to
#     "cp-web-admin":["https://localhost:3200/bff/oauth/callback","https://localhost:3300/bff/oauth/callback"]
#   and add the console's page origins to the WebAuthn origins (clientDataJSON carries the page origin):
#     CARPAL_WEBAUTHN_RP_ID=localhost  CARPAL_WEBAUTHN_ORIGINS=["https://localhost:3000","http://localhost:3200","http://localhost:3300"]
#   Staff accounts for development: pnpm staff:bootstrap (adm1, adm2, mod1, crv1, sup1 @staff.carpals.test, password
#   carpal-staff-dev-password); pnpm dev:staff create|list. Staff need a device-bound passkey (SEC-ADM-2): the first
#   sign-in asks for the password, the emailed code (backend/.data/outbox-mail.jsonl) and a security key or a
#   non-synced platform passkey; Chrome's virtual authenticator (E2E) counts as device-bound.
CARPAL_AUTH_MIN_LATENCY_MS=400      # SEC-AU-11 fixed minimum latency (+0-50 ms jitter) of sign-up/sign-in/OTP/reset start
CARPAL_POW_DIFFICULTY_BITS=18       # auth.pow_challenge difficulty (SEC-BF-7)
CARPAL_TAXONOMY_REFRESH_MS=30000    # taxonomy cache fingerprint check interval

# --- Organizations and media (S4)
CARPAL_LOCATION_CHECK_THRESHOLD_M=300   # pin-versus-address distance above which a location is far_apart
CARPAL_MEDIA_RESCAN_AFTER_MS=300000     # W6: re-queue assets still pending a scan after this long
# CARPAL_MEDIA_CORS_ORIGINS=           # JSON array of web origins allowed to PUT/GET signed media URLs on the lite
#                                      # storage listener; dev default: the PWA on localhost:3000 (http, https) and :3100
CARPAL_DB_POOL_MAX=10

# Secrets. Dev derives every key (JWT Ed25519, KEK, HMAC keys, pepper) from a public
# development master secret; staging and prod refuse to start without a real one.
# CARPAL_MASTER_SECRET=
# CARPAL_JWT_PRIVATE_JWKS=          # JSON array of private Ed25519 JWKs with kid (first one signs)

# Full-mode services (unverified until Docker is installed, OQ-01)
CARPAL_REDIS_URL=redis://127.0.0.1:6379
CARPAL_NATS_URL=nats://127.0.0.1:4222
CARPAL_SEARCH_URL=http://127.0.0.1:9200
CARPAL_S3_ENDPOINT=http://127.0.0.1:9000
CARPAL_SMTP_URL=smtp://127.0.0.1:1025

# Pipeline tuning
CARPAL_MAX_INFLIGHT=512             # requests in flight before load shedding (SEC-RL-2)
CARPAL_RATE_LIMIT_SCALE=1           # multiplies every 40 §2.8 quota
# CARPAL_RATE_LIMITS=               # JSON bucket overrides, e.g. {"search":[{"limit":30,"windowMs":60000,"scope":"user"}]}
# CARPAL_VALIDATE_RESPONSES=        # default 1 in dev: responses checked against the contract
CARPAL_FLAG_REFRESH_MS=30000
CARPAL_AUTHZ_CACHE_MS=30000         # <= 30000 (SEC-AU-3)
CARPAL_OUTBOX_POLL_MS=1000

# Email (backend S26a, NI-07): file = backend/.data/outbox-mail.jsonl (default in lite mode), smtp = CARPAL_SMTP_URL.
# The pilot sends through the carpals.ir mailbox on the cPanel host: smtps://<mailbox>:<password>@mail.carpals.ir:465
# (or smtp://...:587 with STARTTLS; never plain). Percent-encode @ : / in the login (no-reply%40carpals.ir).
# deploy/email_setup_guide.md explains the cPanel side; pnpm mail:test --to <address> checks the settings.
# CARPAL_MAIL_TRANSPORT=file
# CARPAL_MAIL_FROM=CarPal <no-reply@carpals.ir>
# CARPAL_MAIL_REPLY_TO=
# CARPAL_MAIL_MAX_PER_HOUR=300      # shared-hosting quota: above it non-critical mail waits for the next hour
# CARPAL_SMTP_TLS_INSECURE=0        # dev only: accept a self-signed certificate (a local test server)

# Geocoder (backend S26b, DQ-29): fixture (dev, tests) | neshan | unconfigured (503). Unset: fixture in dev (lite), otherwise unconfigured.
# CARPAL_GEOCODER=neshan
# CARPAL_NESHAN_SERVICE_KEY=            # server side only; the web map keys are in the PWA's and the console's own env
# SMS (backend S26a, DQ-28): mock = behaves like a provider, sends nothing (outbox-sms.jsonl); file = the old sink.
# The chosen provider gets its own adapter (libs/sms/providers) and these reserved keys.
# CARPAL_SMS_PROVIDER=mock
# CARPAL_SMS_API_KEY=
# CARPAL_SMS_SENDER_LINE=
# CARPAL_SMS_OTP_TEMPLATE=
# CARPAL_SMS_MOCK_DELIVERY_MS=5000
# CARPAL_SMS_MOCK_FAIL_PERMANENT=   # comma-separated E.164 numbers the mock always refuses
# CARPAL_SMS_MOCK_FAIL_TEMPORARY=   # comma-separated E.164 numbers whose first, third ... send fails temporarily

# Exchange rate (backend S26a.T4): the IRR rate created at start when missing (never overwrites an admin's rate),
# and the hour (region time) of the morning reminder to administrators when the rate was not set that day.
# CARPAL_DEFAULT_IRR_PER_USD=1000000
# CARPAL_RATE_REMINDER_HOUR=9

# Staff seed (backend S26a, DQ-25): the initial password pnpm staff:bootstrap --file gives every new staff account
# (8-128 characters; changed at the first console sign-in within 7 days). Read by the staff command only; never
# commit it. Development accounts (staff:bootstrap without --file) keep the development password.
# CARPAL_STAFF_INITIAL_PASSWORD=
