# Copy to backend/.env (gitignored) to override defaults. All values below are the defaults.

# --- Environment ---------------------------------------------------------------
CARPAL_ENV=dev                     # dev | staging | prod (seeds flags per environment)

# --- Database (tools/db, tests) --------------------------------------------------
# embedded: local PostgreSQL 16 under backend/.data/pg (pnpm db:start / db:stop)
# external: an existing server, e.g. infrastructure/docker/docker-compose.yml
CARPAL_DB_MODE=embedded
CARPAL_DB_HOST=127.0.0.1
CARPAL_DB_PORT=54329
CARPAL_DB_SUPERUSER=postgres
CARPAL_DB_SUPERUSER_PASSWORD=postgres_dev
CARPAL_DB_NAME=carpal
CARPAL_ANALYTICS_DB_NAME=carpal_analytics
CARPAL_DB_LOCALE=C
CARPAL_ADMIN_EMAIL=admin@carpal.app

# Login role passwords (default <role>_dev, e.g. carpal_api_dev). Development only:
# real environments get them from the secret manager (42 §10).
# CARPAL_DB_PASSWORD_MIGRATOR=
# CARPAL_DB_PASSWORD_AUTH=
# CARPAL_DB_PASSWORD_API=
# CARPAL_DB_PASSWORD_ADMIN_API=
# CARPAL_DB_PASSWORD_WORKER=
# CARPAL_DB_PASSWORD_AI=
# CARPAL_DB_PASSWORD_READONLY=
# CARPAL_DB_PASSWORD_ANALYTICS_WRITER=
# CARPAL_DB_PASSWORD_ANALYTICS_READER=

# --- Runtime (S2: libs/config validates all of these at startup) --------------
CARPAL_INFRA=lite                   # lite = in-process adapters + embedded DB; full = docker compose services (GD-04)
CARPAL_STRICT_AUTH=0                # 1 enforces DPoP, mTLS binding, attestation/PoW (GD-06); required in prod
CARPAL_LOG_LEVEL=info               # fatal | error | warn | info | debug | trace | silent
CARPAL_REGION=ir-pilot              # shared/region-config/<region>.json

# HTTP listeners (pnpm dev runs all of them in one process) and public names used in tokens
CARPAL_HTTP_BIND=127.0.0.1
CARPAL_API_PORT=8080
CARPAL_ADMIN_API_PORT=8081
CARPAL_AUTH_PORT=8082
CARPAL_STORAGE_PORT=8083            # lite signed-URL storage (stands in for media.carpal-usercontent.app)
CARPAL_ISSUER=https://id.carpal.app
CARPAL_API_AUDIENCE=https://api.carpal.app
CARPAL_ADMIN_API_AUDIENCE=https://admin-api.carpal.app
# CARPAL_MEDIA_BASE_URL=            # default http://127.0.0.1:<CARPAL_STORAGE_PORT>
CARPAL_I18N_BASE_URL=https://cdn.carpal.app/i18n
CARPAL_I18N_VERSION=dev
CARPAL_CLIENT_MIN_VERSIONS={}       # e.g. {"cp-mobile":"1.2.0"} -> older apps get 400 CLIENT_UPGRADE_REQUIRED
CARPAL_CLIENT_LATEST_VERSION=1.0.0
CARPAL_DB_POOL_MAX=10

# Secrets. Dev derives every key (JWT Ed25519, KEK, HMAC keys, pepper) from a public
# development master secret; staging and prod refuse to start without a real one.
# CARPAL_MASTER_SECRET=
# CARPAL_JWT_PRIVATE_JWKS=          # JSON array of private Ed25519 JWKs with kid (first one signs)

# Full-mode services (unverified until Docker is installed, OQ-01)
CARPAL_REDIS_URL=redis://127.0.0.1:6379
CARPAL_NATS_URL=nats://127.0.0.1:4222
CARPAL_SEARCH_URL=http://127.0.0.1:9200
CARPAL_S3_ENDPOINT=http://127.0.0.1:9000
CARPAL_SMTP_URL=smtp://127.0.0.1:1025

# Pipeline tuning
CARPAL_MAX_INFLIGHT=512             # requests in flight before load shedding (SEC-RL-2)
CARPAL_RATE_LIMIT_SCALE=1           # multiplies every 40 §2.8 quota
# CARPAL_RATE_LIMITS=               # JSON bucket overrides, e.g. {"search":[{"limit":30,"windowMs":60000,"scope":"user"}]}
# CARPAL_VALIDATE_RESPONSES=        # default 1 in dev: responses checked against the contract
CARPAL_FLAG_REFRESH_MS=30000
CARPAL_AUTHZ_CACHE_MS=30000         # <= 30000 (SEC-AU-3)
CARPAL_OUTBOX_POLL_MS=1000
