{
  // Emits the deployable code (apps, libs, modules, workers) to dist/. Tools and tests are not shipped.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false
  },
  "include": ["apps", "libs", "modules", "workers"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.int.test.ts", "**/tests/**", "test", "apps/testing", "libs/testing"]
}
