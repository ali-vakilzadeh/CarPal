# CarPal admin console environment (/carpal/config/admin.env, root:@ADMIN_SERVICE_GROUP@ 0640).
# Read by systemd (EnvironmentFile) and by admin-update.sh for `next build`. KEY=value, no spaces around "=", no
# "export", JSON values in single quotes. admin-setup.sh wrote it once; it is never overwritten. Every variable is
# validated at startup (frontend/admin-console/src/server/env.ts): a bad value stops the service and
# `journalctl -u @ADMIN_SERVICE_NAME@` names it. After a change: sudo bash admin-update.sh (or systemctl restart).

# --- Environment -------------------------------------------------------------------
# The badge every page shows (prod | staging). Outside dev the console requires https origins, strict auth and the key.
CARPAL_ADMIN_ENV=@ADMIN_ENV@
# Must equal the backend's CARPAL_STRICT_AUTH (backend.env): DPoP-bound tokens and private_key_jwt.
CARPAL_STRICT_AUTH=1
# Private key of cp-web-admin for private_key_jwt (secret; from /carpal/config/oauth-admin-client-keys.json, whose
# public half is in the backend's CARPAL_OAUTH_CLIENT_JWKS). Only this file and that one hold it, never pwa.env.
CARPAL_ADMIN_CLIENT_PRIVATE_JWKS='@CLIENT_PRIVATE_JWKS@'

# --- Public origin (the BFF's Origin check, the redirect <origin>/bff/oauth/callback, the WebAuthn origin) ------
# Must be in the backend's CARPAL_OAUTH_REDIRECT_URIS (cp-web-admin) and CARPAL_WEBAUTHN_ORIGINS.
CARPAL_ADMIN_ORIGIN=https://@ADMIN_CONSOLE_HOST@
CARPAL_ADMIN_DEFAULT_LOCALE=fa
CARPAL_ADMIN_DEFAULT_TIME_ZONE=Asia/Tehran

# --- Backend (server side only; the browser never calls these addresses) -----------------
# admin-api is never published (SEC-ADM-1): the BFF reaches it over 127.0.0.1.
CARPAL_ADMIN_API_URL=@BACKEND_ADMIN_API_URL@
CARPAL_AUTH_URL=@BACKEND_AUTH_URL@
# Equal to the backend's CARPAL_ADMIN_API_AUDIENCE (the htu of the BFF's DPoP proofs on admin-api).
CARPAL_ADMIN_API_AUDIENCE=https://@ADMIN_HOST@

# --- Media and links (AC8, R-23) -------------------------------------------------------
# Storage host of the 5-minute signed display copies (the page CSP allows it for images and video). It must answer
# Cross-Origin-Resource-Policy: cross-origin (the backend's storage listener does; never add same-origin in nginx).
CARPAL_STORAGE_URL=https://@MEDIA_HOST@
# The public app for "Open the public page" and "View public profile".
CARPAL_ADMIN_PUBLIC_WEB_URL=https://@WEB_HOST@
# The Locations map has no basemap in the console (OQ-16 (c): "Open in Neshan" instead). Leave unset.
# CARPAL_ADMIN_MAP_STYLE_URL=

# --- BFF session store (D-22, decided in AC11: D-112) -----------------------------------
# lite = in this process only. Staff tokens never leave the console process; a restart (every update) signs staff
# out and drops a lost-key recovery that is waiting for approvals (deploy.md "Updates").
CARPAL_ADMIN_SESSION_STORE=lite

# --- Never in production ------------------------------------------------------------
# CARPAL_ADMIN_OAUTH_REDIRECT_URI must stay unset (dev/E2E shim; refused outside dev).
