# CarPal admin console — environment (AC1). Copy to .env.local for `pnpm dev`.
# Every variable is read and validated in src/server/env.ts; unknown values fail at start-up.

# Which environment this console serves. Drives the always-visible environment badge (GD-06): dev | staging | prod.
CARPAL_ADMIN_ENV=dev

# Public origin of the console (dev: https://localhost:3200 once the BFF lands in AC3; prod: https://admin.<DOMAIN>).
CARPAL_ADMIN_ORIGIN=http://localhost:3200

# Language when neither the cpa_locale cookie nor Accept-Language decides (OQ-06 default: fa). From AC4 on the
# signed-in staff member's me.locale wins.
CARPAL_ADMIN_DEFAULT_LOCALE=fa

# Time zone for dates until the browser reports its own (stored and sent in UTC; GD-05).
CARPAL_ADMIN_DEFAULT_TIME_ZONE=Asia/Tehran

# Added in AC3 (BFF): CARPAL_ADMIN_CLIENT_ID=cp-web-admin, CARPAL_ADMIN_CLIENT_PRIVATE_JWKS, CARPAL_AUTH_ISSUER,
# CARPAL_ADMIN_API_URL (backend lite: http://localhost:8081), CARPAL_API_URL (http://localhost:8080),
# CARPAL_ADMIN_OAUTH_REDIRECT_URI, session store settings.
