# CarPal admin console — environment (AC1, BFF settings AC3). Copy to .env.local for `pnpm dev`.
# Every variable is read and validated in src/server/env.ts; unknown values fail at start-up.

# Which environment this console serves. Drives the always-visible environment badge (GD-06): dev | staging | prod.
CARPAL_ADMIN_ENV=dev

# Public origin of the console (dev: http://localhost:3200, OQ-11; prod: https://admin.<DOMAIN>).
CARPAL_ADMIN_ORIGIN=http://localhost:3200

# Language when neither the cpa_locale cookie nor Accept-Language decides (OQ-06 default: fa). Since AC4 the first
# sign-in sets cpa_locale from the staff member's language (admin.staff_me) unless this browser already chose one.
CARPAL_ADMIN_DEFAULT_LOCALE=fa

# Time zone for dates until the browser reports its own (stored and sent in UTC; GD-05).
CARPAL_ADMIN_DEFAULT_TIME_ZONE=Asia/Tehran

# --- BFF (AC3) ---
# Backend hosts the BFF calls (backend lite: admin-api :8081, auth :8082) and the admin-api audience (DPoP htu).
CARPAL_ADMIN_API_URL=http://127.0.0.1:8081
CARPAL_AUTH_URL=http://127.0.0.1:8082
CARPAL_ADMIN_API_AUDIENCE=https://admin-api.carpals.ir

# Mirrors the backend's CARPAL_STRICT_AUTH: 1 = private_key_jwt at /oauth/token. Required outside dev.
CARPAL_STRICT_AUTH=0

# Private JWK of cp-web-admin, JSON {"cp-web-admin":{…}}: the content of the key file made by
# `node backend/deploy/gen-client-keys.mjs --admin`. Required in strict mode and outside dev. Secret: never in the PWA's env.
# CARPAL_ADMIN_CLIENT_PRIVATE_JWKS=

# Dev and E2E only: the backend registers https redirect URIs, so a console on http registers the https one and the
# /id proxy brings the code back to http (OQ-11). Refused outside dev.
CARPAL_ADMIN_OAUTH_REDIRECT_URI=https://localhost:3200/bff/oauth/callback

# Session store: lite (in memory, one process; sessions end on restart) or redis (then set CARPAL_ADMIN_REDIS_URL).
CARPAL_ADMIN_SESSION_STORE=lite
# CARPAL_ADMIN_REDIS_URL=redis://127.0.0.1:6379/3
